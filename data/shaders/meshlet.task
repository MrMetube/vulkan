#version 460

#extension GL_EXT_shader_explicit_arithmetic_types: require
#extension GL_EXT_mesh_shader: require

#include "common.glsl"

////////////////////////////////////////////////

layout(local_size_x = TaskWidth, local_size_y = 1, local_size_z = 1) in;

layout(constant_id = 0) const bool Late = false;
layout(constant_id = 1) const bool Post = false;

layout(push_constant) uniform _ { Draw_Data data; };

layout(descriptor_heap) uniform texture2D Textures[];
layout(descriptor_heap) uniform sampler   Samplers[];

////////////////////////////////////////////////

taskPayloadSharedEXT Task_Result task_result;

shared int shared_count;

////////////////////////////////////////////////

void main() {
    uint thread_index  = gl_LocalInvocationIndex;
    uint command_index = gl_WorkGroupID.x;
    
    Draw_Command command = data.draw_command_buffer[command_index].v;
    uint draw_index                  = command.draw_index;
    uint meshlet_offset              = command.meshlet_offset;
    bool mesh_was_visible_last_frame = command.mesh_was_visible_last_frame;
    
    Draw draw = data.draw_buffer[draw_index].v;
    
    uint meshlet_index            = thread_index + meshlet_offset;
    uint meshlet_visibility_index = thread_index + command.meshlet_visibility_offset;
    
    bool frustum_culling_enabled = (data.flags & Flag_FrustumCulling)   != 0;
    bool occlusion_enabled       = (data.flags & Flag_OcclusionCulling) != 0;
    
    
    
    task_result.draw_index     = draw_index;
    task_result.meshlet_offset = meshlet_offset;
    
    shared_count = 0; 
    barrier(); // for shared_count
    
    
    
    if (thread_index < command.meshlet_count) {
        uint meshlet_visibility_bit_index = meshlet_visibility_index >> 5;
        uint meshlet_visibility_mask      = 1 << (meshlet_visibility_index & 31);
        uint meshlet_was_visible_last_frame = data.meshlet_visibility_buffer[meshlet_visibility_bit_index].v & meshlet_visibility_mask;
        
        bool visible = true;
        bool skip    = false;
        if (!Post && occlusion_enabled) {
            // If we disabled occlusion culling, the cull status of draw calls with Late=false is never updated, because they are skipped
            if (!Late && meshlet_was_visible_last_frame == 0)                                visible = false;
            if ( Late && meshlet_was_visible_last_frame != 0 && mesh_was_visible_last_frame) skip    = true;
        }
        
        Meshlet_p meshlet = data.meshlet_buffer[meshlet_index];
        
        vec3  world_center = transform(draw.orientation, draw.scale, draw.p, meshlet.v.center);
        float radius       = draw.scale * meshlet.v.radius;
        vec4  view_center  = data.view_from_world * vec4(world_center, 1);
        
        vec3  cone_axis       = vec3(int(meshlet.v.cone_axis[0]), int(meshlet.v.cone_axis[1]), int(meshlet.v.cone_axis[2])) / 127.0;
        vec3  world_cone_axis = rotate(draw.orientation, cone_axis);
        vec3  view_cone_axis  = mat3(data.view_from_world) * world_cone_axis;
        float cone_cutoff     = float(meshlet.v.cone_cutoff) / 127.0;
        
        // backface cone culling
        visible = visible && !cone_cull(view_center.xyz, radius, view_cone_axis, cone_cutoff, vec3(0));
        
        // @copypasta from cull.comp
        if (frustum_culling_enabled) {
            // the left/top/right/bottom plane culling utilizes frustum symmetry to cull against two planes at the same time
            visible = visible && view_center.z * data.frustum[1] - abs(view_center.x) * data.frustum[0] > -radius;
            visible = visible && view_center.z * data.frustum[3] - abs(view_center.y) * data.frustum[2] > -radius;
            // the near/far plane culling uses camera space Z directly, but the camera looks down -z :ViewSpace:
            visible = visible && view_center.z - radius < data.near_z && view_center.z + radius > -data.far_z;
        }
        
        // @copypasta from cull.comp
        if (Late && occlusion_enabled && visible) {
            float s00    = data.s00;
            float s11    = data.s11;
            float near_z = data.near_z;
            vec2  size   = data.pyramid_size;
            
            vec4 rect;
            if (project_sphere_onto_screen(view_center.xyz, radius, s00, s11, near_z, rect)) {
                vec2 size_in_pixels = (rect.zw - rect.xy) * size;
                
                // Because we only consider 2x2 pixels, we need to make sure we are sampling from a mip that reduces the rectangle to 1x1 texel or smaller.
                // Due to the rectangle being arbitrarily offset, a 1x1 rectangle may cover 2x2 texel area. Using floor() here would require sampling 4 corners
                // of AABB (using bilinear fetch), which is a little slower. - by zeux
                float level = ceil(log2(max(size_in_pixels.x, size_in_pixels.y)));
                vec2  rect_center = (rect.xy + rect.zw) * 0.5;
                
                float depth = textureLod(sampler2D(Textures[data.depth_pyramid_index], Samplers[Sampler_Depth]), rect_center, level).x;
                float min_sphere_depth = -near_z / (view_center.z + radius); // :ViewSpace:
                
                visible = visible && (min_sphere_depth > depth);
            }
        }
        
        if (Late && occlusion_enabled) {
            // @speed If we ensure that all threads/lanes write to the same two 32-bit slot and don't straddle 3 slots
            // in the buffer, then we can use atomics to built the whole slots new value in shared memory and then
            // write it once into the buffer. This requires that draw.meshlet_visibility_offset is aligned to 32.
            // Then we calculate the base slot index and construct the slots value with atomicOrs per threads and write
            // it with thread 0 into the buffer.
            
            if (visible) {
                atomicOr(data.meshlet_visibility_buffer[meshlet_visibility_bit_index].v,   meshlet_visibility_mask);
            } else {
                atomicAnd(data.meshlet_visibility_buffer[meshlet_visibility_bit_index].v, ~meshlet_visibility_mask);
            }
        }
        
        if (visible && !skip) {
            uint index = atomicAdd(shared_count, 1);
            task_result.indices[index] = meshlet_index;
        }
    }
    
    barrier(); // for shared_count
    
    EmitMeshTasksEXT(shared_count, 1, 1);
}