#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types: require
#extension GL_ARB_shader_draw_parameters: require
#extension GL_KHR_shader_subgroup_ballot: require

#include "common.glslh"

////////////////////////////////////////////////

// @volatile
layout(push_constant) uniform Push_Data {
    Draw_Globals globals;
};

layout(binding = 0, std430, scalar) readonly buffer Draws {
	Draw draw_buffer[];
};

layout(binding = 1, std430, scalar) readonly buffer Meshes {
	Mesh mesh_buffer[];
};

layout(binding = 2, std430, scalar) readonly buffer Meshlets {
	Meshlet meshlet_buffer[];
};

layout(binding = 5, std430, scalar) readonly buffer Draw_Commands {
    Draw_Command draw_command_buffer[];
};

////////////////////////////////////////////////

bool cone_cull(vec3 center, float radius, vec3 axis, float cutoff, vec3 camera) {
    vec3 delta = center - camera;
    return dot(delta, axis) >= cutoff * length(delta) + radius;
}

////////////////////////////////////////////////

layout(local_size_x = TaskWidth, local_size_y = 1, local_size_z = 1) in;

taskPayloadSharedEXT Task_Result task_result;

#define BACKFACE_CULLING true

void main() {
    uint meshlet_group_index = gl_WorkGroupID.x;
    uint thread_index        = gl_LocalInvocationID.x;
    Draw_Command command     = draw_command_buffer[gl_DrawID];
    uint draw_index          = command.draw_id;
    
    Draw draw = draw_buffer[draw_index];
    Mesh mesh = mesh_buffer[draw.mesh_index];
    
    Mesh_LOD lod = mesh.lods[command.lod_index];
    uint meshlet_index = meshlet_group_index * TaskWidth + thread_index + lod.meshlet_offset;
    
    if (thread_index == 0) {
        task_result.draw_index = draw_index;
        // see :DrawAndLODData:
        task_result.meshlet_offset = lod.meshlet_offset;
    }
    
    uint count;
    if (BACKFACE_CULLING) {
        Meshlet meshlet = meshlet_buffer[meshlet_index];
        
        bool accept = false;
        if (meshlet_index < (lod.meshlet_count + lod.meshlet_offset)) {
            vec3 cone_axis   = vec3(meshlet.cone_axis[0], meshlet.cone_axis[1], meshlet.cone_axis[2]) / 127.0;
            float cone_cutoff = float(meshlet.cone_cutoff) / 127.0;
            vec3 center      = meshlet.center;
            float radius     = meshlet.radius;
            
            cone_axis = rotate(draw.orientation, cone_axis);
            center    = transform(draw.orientation, draw.scale, draw.p, center);
            radius   *= draw.scale;
            
            vec3 camera_position = vec3(globals.view[0].w, globals.view[1].w, globals.view[2].w);
            
            accept = !cone_cull(center, radius, cone_axis, cone_cutoff, camera_position);
        }
        
        uvec4 ballot = subgroupBallot(accept);
        uint index   = subgroupBallotExclusiveBitCount(ballot); // how many threads, before this thread, had accept==true
        count        = subgroupBallotBitCount(ballot);          // how many threads, in total, had accept==true
        
        if (accept) {
            task_result.indices[index] = meshlet_index;
        }
    } else {
        task_result.indices[thread_index] = meshlet_index;
        
        count = min(TaskWidth, lod.meshlet_count - (meshlet_group_index * TaskWidth + 0));
    }
    
    EmitMeshTasksEXT(count, 1, 1);
}