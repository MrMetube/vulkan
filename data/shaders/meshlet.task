#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types: require
#extension GL_ARB_shader_draw_parameters: require
#extension GL_KHR_shader_subgroup_ballot: require

#include "common.glsl"

////////////////////////////////////////////////

// @volatile
layout(push_constant) uniform Push_Data {
    Draw_Globals data;
};

////////////////////////////////////////////////

bool cone_cull(vec3 center, float radius, vec3 axis, float cutoff, vec3 camera) {
    vec3 delta = center - camera;
    return dot(delta, axis) >= cutoff * length(delta) + radius;
}

////////////////////////////////////////////////

layout(local_size_x = TaskWidth, local_size_y = 1, local_size_z = 1) in;

taskPayloadSharedEXT Task_Result task_result;

#define BACKFACE_CULLING true

void main() {
    uint meshlet_group_index = gl_WorkGroupID.x;
    uint thread_index        = gl_LocalInvocationID.x;
    Draw_Command_p command   = data.draw_command_buffer[gl_DrawID];
    uint draw_index          = command.v.draw_id;
    
    Draw_p draw = data.draw_buffer[draw_index];
    Mesh_p mesh = data.mesh_buffer[draw.v.mesh_index];
    
    uint meshlet_index = meshlet_group_index * TaskWidth + thread_index + command.v.meshlet_offset;
    
    if (thread_index == 0) {
        task_result.draw_index     = draw_index;
        task_result.meshlet_offset = command.v.meshlet_offset;
    }
    
    uint count;
    if (BACKFACE_CULLING) {
        bool accept = false;
        if (meshlet_index < (command.v.meshlet_count + command.v.meshlet_offset)) {
            Meshlet_p meshlet = data.meshlet_buffer[meshlet_index];
            
            vec3 cone_axis    = vec3(meshlet.v.cone_axis[0], meshlet.v.cone_axis[1], meshlet.v.cone_axis[2]) / 127.0;
            float cone_cutoff = float(meshlet.v.cone_cutoff) / 127.0;
            vec3 center       = transform(draw.v.orientation, draw.v.scale, draw.v.p, meshlet.v.center);
            float radius      = meshlet.v.radius * draw.v.scale;
            
            cone_axis = rotate(draw.v.orientation, cone_axis);
            
            vec3 view_camera_position = vec3(0);
            
            // @todo radius and cutoff might need scaling if the view_from_world matrix is more than translating
            vec4 view_center    = data.data.view_from_world * vec4(center, 1);
            vec4 view_cone_axis = data.data.view_from_world * vec4(cone_axis, 0);
            
            accept = !cone_cull(view_center.xyz, radius, view_cone_axis.xyz, cone_cutoff, view_camera_position);
        }
        
        uvec4 ballot = subgroupBallot(accept);
        uint index   = subgroupBallotExclusiveBitCount(ballot); // how many threads, before this thread, had accept==true
        count        = subgroupBallotBitCount(ballot);          // how many threads, in total, had accept==true
        
        if (accept) {
            task_result.indices[index] = meshlet_index;
        }
    } else {
        task_result.indices[thread_index] = meshlet_index;
        
        count = min(TaskWidth, command.v.meshlet_count - (meshlet_group_index * TaskWidth + 0));
    }
    
    EmitMeshTasksEXT(count, 1, 1);
}