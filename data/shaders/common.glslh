
#extension GL_EXT_buffer_reference: require
#extension GL_EXT_buffer_reference2: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_EXT_buffer_reference   : require
#extension GL_EXT_scalar_block_layout: require

// @todo(viktor): should a ^uint be aligned by 8 or by 4, or should it be the align_of(T) of the cpu type
#define Pointer(T) layout(buffer_reference, buffer_reference_align = 8, std430, scalar) buffer T##_p { T v; }

#include "api.generated.glslh"

#define Debug false

#define TaskWidth 32

struct Task_Result {
    uint indices[TaskWidth];
    uint draw_index;
    uint meshlet_offset;
};


struct Mesh_Result {
    vec3 normal;
    vec2 uv;
    vec3 light_vec[4];
    vec3 view_vec;

    vec3 debug_color; // @cleanup
};

////////////////////////////////////////////////

vec3 rotate (vec4 q, vec3 v) {
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}

vec3 transform(vec4 orientation, float scale, vec3 offset, vec3 p) {
    return rotate(orientation, p) * scale + offset;
}