#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types: require
#extension GL_ARB_shader_draw_parameters: require

#include "common.glsl"

#define MeshWidth 32

////////////////////////////////////////////////

// @volatile
#define MaxVertices  64
#define MaxTriangles 84

// @volatile
layout(push_constant) uniform Push_Data {
    Draw_Globals globals;
};

taskPayloadSharedEXT Task_Result task_result;

////////////////////////////////////////////////

uint hash(uint a) {
    a = (a + 0x7ed55d16) + (a << 12);
    a = (a ^ 0xc761c23c) ^ (a >> 19);
    a = (a + 0x165667b1) + (a << 5);
    a = (a + 0xd3a2646c) ^ (a << 9);
    a = (a + 0xfd7046c5) + (a << 3);
    a = (a ^ 0xb55a4f09) ^ (a >> 16);
    return a;
}

////////////////////////////////////////////////

layout(local_size_x = MeshWidth, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MaxVertices, max_primitives = MaxTriangles) out;

layout(location = 0) flat   out Mesh_Result_Flat mesh_result_flat[];
layout(location = 1) smooth out Mesh_Result_Smooth mesh_result_smooth[];

void main() {
    uint thread_index   = gl_LocalInvocationID.x;
	uint meshlet_index  = task_result.indices[gl_WorkGroupID.x];
    uint draw_index     = task_result.draw_index;
    uint meshlet_offset = task_result.meshlet_offset;
    
    Draw_p draw = globals.draw_buffer[draw_index];
    
    // @cleanup can this even happen here anymore?
    // if (meshlet_index < (draw.v.meshlet_count + meshlet_offset)) {
    Meshlet_p meshlet = globals.meshlet_buffer[meshlet_index];
    
    uint vertex_count   = meshlet.v.vertex_count;
    uint triangle_count = meshlet.v.triangle_count;
    
    if (thread_index == 0) {
        SetMeshOutputsEXT(vertex_count, triangle_count);
    }
    
    uint vertex_offset = meshlet.v.data_offset;
    uint index_offset  = vertex_offset + vertex_count;
    
    for (uint i = thread_index; i < vertex_count; i += MeshWidth) {
        uint vertex_index = draw.v.vertex_offset + globals.meshlet_data_buffer[vertex_offset + i].v;
        Vertex_p vertex = globals.vertex_buffer[vertex_index];
        
        vec3 model_p = vertex.v.p;
        vec3 world_p = transform(draw.v.orientation, draw.v.scale, draw.v.p, model_p);
        vec4 view_p = globals.data.view_from_world * vec4(world_p, 1.0);
        vec4 screen_p = globals.data.screen_from_view * view_p;
        
        vec3 model_n = vec3(vertex.v.n[0], vertex.v.n[1], vertex.v.n[2]) / 127.5 - 1;
        vec3 world_n = rotate(draw.v.orientation, model_n);
        vec3 view_n  = mat3(globals.data.view_from_world) * world_n;
        Mesh_Result_Smooth result;
        
        for (int li = 0; li < 4; li++) {
            vec4 world_light_p  = vec4(globals.data.light_pos[li].xyz, 1);
            vec4 view_light_p   = globals.data.view_from_world * world_light_p;
            result.light_vec[li] =  view_light_p.xyz - view_p.xyz;
        }
        result.view_vec = -view_p.xyz;
        result.uv     = vertex.v.uv;
        result.normal = view_n;
        
        // vulkan uses a inverted y-axis, so we invert it back to the regular y+ = up here
        gl_MeshVerticesEXT[i].gl_Position = screen_p * vec4(1, -1, 1, 1);
        
        #if Debug
            uint mhash = hash(meshlet_index);
            result.debug_color = vec3(float(mhash & 255), float((mhash >> 8) & 255), float((mhash >> 16) & 255)) / 255.0;
        #endif // Debug
        
        mesh_result_smooth[i] = result;
        mesh_result_flat[i].texture_index = draw.v.texture_index;
    }
    
    uint group_count = (triangle_count * 3 + 3) / 4;
    for (uint i = thread_index; i < group_count; i += MeshWidth) {
        uint word_index = index_offset + (i * 3);
        
        uint u0 = globals.meshlet_data_buffer[word_index + 0].v;
        uint u1 = globals.meshlet_data_buffer[word_index + 1].v;
        uint u2 = globals.meshlet_data_buffer[word_index + 2].v;
        
        uint triangle_index = i * 4;
        
        if (triangle_index + 0 < triangle_count) {
            gl_PrimitiveTriangleIndicesEXT[triangle_index + 0] = uvec3((u0 >>  0) & 0xFF, (u0 >>  8) & 0xFF, (u0 >> 16) & 0xFF);
        }
        if (triangle_index + 1 < triangle_count) {
            gl_PrimitiveTriangleIndicesEXT[triangle_index + 1] = uvec3((u0 >> 24) & 0xFF, (u1 >>  0) & 0xFF, (u1 >>  8) & 0xFF);
        }
        if (triangle_index + 2 < triangle_count) {
            gl_PrimitiveTriangleIndicesEXT[triangle_index + 2] = uvec3((u1 >> 16) & 0xFF, (u1 >> 24) & 0xFF, (u2 >>  0) & 0xFF);
        }
        if (triangle_index + 3 < triangle_count) {
            gl_PrimitiveTriangleIndicesEXT[triangle_index + 3] = uvec3((u2 >>  8) & 0xFF, (u2 >> 16) & 0xFF, (u2 >> 24) & 0xFF);
        }
    }
}