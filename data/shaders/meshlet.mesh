#version 460

#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_explicit_arithmetic_types: require
#extension GL_ARB_shader_draw_parameters: require

#include "common.glslh"

#define MeshWidth 32

////////////////////////////////////////////////

// @volatile
#define MaxVertices  64
#define MaxTriangles 84

// @volatile
layout(push_constant) uniform Push_Data {
    Draw_Globals globals;
};

// @volatile
struct Vertex {
    vec3 p; float p_pad;
    uint8_t  nx, ny, nz, n_pad;
	vec2 t;
};


layout(binding = 0, std430, scalar) readonly buffer Draws {
	Draw draw_buffer[];
};

layout(binding = 2, std430, scalar) readonly buffer Meshlets {
	Meshlet meshlet_buffer[];
};

layout(binding = 3, std430, scalar) readonly buffer MeshletData {
	uint meshlet_data_buffer[];
};

layout(binding = 4, std430, scalar) readonly buffer Vertices {
	Vertex vertex_buffer[];
};


taskPayloadSharedEXT Task_Result task_result;

////////////////////////////////////////////////

uint hash(uint a) {
    a = (a + 0x7ed55d16) + (a << 12);
    a = (a ^ 0xc761c23c) ^ (a >> 19);
    a = (a + 0x165667b1) + (a << 5);
    a = (a + 0xd3a2646c) ^ (a << 9);
    a = (a + 0xfd7046c5) + (a << 3);
    a = (a ^ 0xb55a4f09) ^ (a >> 16);
    return a;
}

////////////////////////////////////////////////

layout(local_size_x = MeshWidth, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = MaxVertices, max_primitives = MaxTriangles) out;

layout(location = 0) out Mesh_Result mesh_result[];

void main() {
    uint thread_index  = gl_LocalInvocationID.x;
	uint meshlet_index = task_result.indices[gl_WorkGroupID.x];
    uint draw_index    = task_result.draw_index;
    // :DrawAndLODData: @cleanup niagara managed to "pass" the offset by using the NV functions, which allow for an offset.
    // this is so that the Draw structure, does not need to store the meshlet offset for the mesh shader,
    // which then only requires then draw.vertex_offset, and all other fields can be moved into a separate
    // buffer alongside the LOD data.
    uint meshlet_offset = task_result.meshlet_offset;
    
    Draw draw = draw_buffer[draw_index];
    
    Meshlet meshlet;
    
    // @cleanup can this even happen here anymore?
    // if (meshlet_index < (draw.meshlet_count + meshlet_offset)) {
        meshlet = meshlet_buffer[meshlet_index];
    // }
    
    uint vertex_count   = meshlet.vertex_count;
    uint triangle_count = meshlet.triangle_count;
    
    if (thread_index == 0) {
        SetMeshOutputsEXT(vertex_count, triangle_count);
    }
    
    uint vertex_offset = meshlet.data_offset;
    uint index_offset  = vertex_offset + vertex_count;
        
    for (uint i = thread_index; i < vertex_count; i += MeshWidth) {
        uint vertex_index = draw.vertex_offset + meshlet_data_buffer[vertex_offset + i];
        Vertex vertex = vertex_buffer[vertex_index];
        
        vec3 p = vertex.p;
        p = rotate(draw.orientation, p);
        p *= draw.scale;
        p += draw.p;
        vec4 view_p = vec4(p, 1.0);
        
        vec3 n = vec3(vertex.nx, vertex.ny, vertex.nz) / 127.0 - 1.0;
        vec2 t = vertex.t;
        
        Mesh_Result result;
        view_p = globals.view * view_p;
        
        vec4 position = globals.projection * (globals.view * view_p);
        result.normal = mat3(globals.view) * n;
        result.uv     = t;
        
        for (int li = 0; li < 4; li++) {
            result.light_vec[li] = globals.light_pos[li].xyz - view_p.xyz;
        }
        result.view_vec = -view_p.xyz;
        
        if (Debug) {
            uint mhash = hash(meshlet_index);
            result.debug_color = vec3(float(mhash & 255), float((mhash >> 8) & 255), float((mhash >> 16) & 255)) / 255.0;
        }
        
        // vulkan uses a inverted y-axis, so we invert it back to the regular y+ = up here
        gl_MeshVerticesEXT[i].gl_Position = position * vec4(1, -1, 1, 1);
        mesh_result[i] = result;
    }
    
    uint group_count = (triangle_count * 3 + 3) / 4;
    for (uint i = thread_index; i < group_count; i += MeshWidth) {
        uint word_index = index_offset + (i * 3);
        
        uint u0 = meshlet_data_buffer[word_index + 0];
        uint u1 = meshlet_data_buffer[word_index + 1];
        uint u2 = meshlet_data_buffer[word_index + 2];
        
        uint triangle_index = i * 4;
        
        if (triangle_index + 0 < triangle_count) {
            gl_PrimitiveTriangleIndicesEXT[triangle_index + 0] = uvec3((u0 >>  0) & 0xFF, (u0 >>  8) & 0xFF, (u0 >> 16) & 0xFF);
        }
        if (triangle_index + 1 < triangle_count) {
            gl_PrimitiveTriangleIndicesEXT[triangle_index + 1] = uvec3((u0 >> 24) & 0xFF, (u1 >>  0) & 0xFF, (u1 >>  8) & 0xFF);
        }
        if (triangle_index + 2 < triangle_count) {
            gl_PrimitiveTriangleIndicesEXT[triangle_index + 2] = uvec3((u1 >> 16) & 0xFF, (u1 >> 24) & 0xFF, (u2 >>  0) & 0xFF);
        }
        if (triangle_index + 3 < triangle_count) {
            gl_PrimitiveTriangleIndicesEXT[triangle_index + 3] = uvec3((u2 >>  8) & 0xFF, (u2 >> 16) & 0xFF, (u2 >> 24) & 0xFF);
        }
    }
    
}