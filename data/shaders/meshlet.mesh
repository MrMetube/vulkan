#version 460

#extension GL_EXT_shader_explicit_arithmetic_types: require
#extension GL_EXT_mesh_shader: require
#extension GL_NV_explicit_typecast: require

#include "common.glsl"

// @volatile
#define MaxVertices   64
#define MaxTriangles 126

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform _ { Draw_Globals globals; };

taskPayloadSharedEXT Task_Result task_result;
layout(triangles, max_vertices = MaxVertices, max_primitives = MaxTriangles) out;

layout(location = 0) flat   out uint               draw_index[];
layout(location = 1) smooth out Mesh_Result mesh_result_smooth[];

////////////////////////////////////////////////

#define Cull_Backfacing_and_Small_Triangles 1

#if Cull_Backfacing_and_Small_Triangles
shared vec3 vertex_screen[MaxVertices];
#endif // Cull_Backfacing_and_Small_Triangles

////////////////////////////////////////////////

uint hash(uint a);

void main() {
    uint thread_index   = gl_LocalInvocationIndex;
	uint meshlet_index  = task_result.indices[gl_WorkGroupID.x];
    uint group_size     = gl_WorkGroupSize.x;
    uint meshlet_offset = task_result.meshlet_offset;
    
    Draw_p draw       = globals.draw_buffer[task_result.draw_index];
    Meshlet_p meshlet = globals.meshlet_buffer[meshlet_index];
    
    uint vertex_count   = meshlet.v.vertex_count;
    uint triangle_count = meshlet.v.triangle_count;
    
    SetMeshOutputsEXT(vertex_count, triangle_count);
    
    uint vertex_offset = meshlet.v.data_offset;
    uint index_offset  = vertex_offset + vertex_count;
    
    uint i = thread_index;
    if (i < vertex_count) {
        uint vertex_index = draw.v.vertex_offset + globals.meshlet_data_buffer[vertex_offset + i].v;
        Vertex_p vertex = globals.vertex_buffer[vertex_index];
        
        vec3 model_p = vertex.v.p;
        vec3 world_p = transform(draw.v.orientation, draw.v.scale, draw.v.p, model_p);
        vec4 view_p = globals.data.view_from_world * vec4(world_p, 1.0);
        vec4 screen_p = globals.data.screen_from_view * view_p;
        
        vec3 model_n = vec3(vertex.v.n[0], vertex.v.n[1], vertex.v.n[2]) / 127.5 - 1;
        vec3 world_n = rotate(draw.v.orientation, model_n);
        vec3 view_n  = mat3(globals.data.view_from_world) * world_n;
        Mesh_Result result;
        
        for (int li = 0; li < 4; li++) {
            vec4 world_light_p  = vec4(globals.data.light_pos[li].xyz, 1);
            vec4 view_light_p   = globals.data.view_from_world * world_light_p;
            result.light_vec[li] =  view_light_p.xyz - view_p.xyz;
        }
        result.view_vec = -view_p.xyz;
        result.uv     = vertex.v.uv;
        result.normal = view_n;
        
        
        #if Debug
            uint mhash = hash(meshlet_index);
            result.debug_color = vec3(float(mhash & 255), float((mhash >> 8) & 255), float((mhash >> 16) & 255)) / 255.0;
        #endif // Debug
        
        #if Cull_Backfacing_and_Small_Triangles
            vertex_screen[i] = vec3((screen_p.xy / screen_p.w * 0.5 + 0.5) * globals.data.screen_size, screen_p.w);
        #endif // Cull_Backfacing_and_Small_Triangles
        
        gl_MeshVerticesEXT[i].gl_Position = screen_p;
        
        mesh_result_smooth[i] = result;
        draw_index[i] = task_result.draw_index;
    }
    
    #if Cull_Backfacing_and_Small_Triangles
        barrier();
    #endif // Cull_Backfacing_and_Small_Triangles
    
    uint8_t_p meshlet_data_bytes = uint8_t_p(globals.meshlet_data_buffer);
    for (uint i = thread_index; i < triangle_count; i += group_size) {
        uint offset = index_offset * 4 + i * 3;
        
        uint ia = meshlet_data_bytes[offset + 0].v;
        uint ib = meshlet_data_bytes[offset + 1].v;
        uint ic = meshlet_data_bytes[offset + 2].v;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(ia, ib, ic);
        
        #if Cull_Backfacing_and_Small_Triangles
            bool culled = false;
            
            vec2 a = vertex_screen[ia].xy;
            vec2 b = vertex_screen[ib].xy;
            vec2 c = vertex_screen[ic].xy;
            
            vec2 ab = b - a;
            vec2 ac = c - a;
            
            // :ViewSpace: The signed area is negative if facing away from the screen, but we invert the y-axis
            // therefore this calculation is negated
            float signed_triangle_area = -(ab.x * ac.y - ab.y * ac.x);
            culled = culled || (signed_triangle_area <= 0);
            
            // small primitive culling
            vec2 b_min = min(a, min(b, c));
            vec2 b_max = max(a, max(b, c));
            float subpixel_precision = 1 / 256.0; // This can be set to 1 / 2^subpixelPrecisionBits
            
            // This is slightly imprecise, as in it doesn't fully match hardware behaviour and is both too loose and too strict.
            culled = culled || (
                round(b_min.x - subpixel_precision) == round(b_max.x + subpixel_precision) || 
                round(b_min.y - subpixel_precision) == round(b_max.y + subpixel_precision)
            );
            
            // the previous computations are only valid if all vertices are in front of the perspective plane
            culled = culled && (vertex_screen[ia].z > 0 && vertex_screen[ib].z > 0 && vertex_screen[ic].z > 0);
            
            gl_MeshPrimitivesEXT[i].gl_CullPrimitiveEXT = culled;
        #endif // Cull_Backfacing_and_Small_Triangles
    }
}

uint hash(uint a) {
    a = (a + 0x7ed55d16) + (a << 12);
    a = (a ^ 0xc761c23c) ^ (a >> 19);
    a = (a + 0x165667b1) + (a << 5);
    a = (a + 0xd3a2646c) ^ (a << 9);
    a = (a + 0xfd7046c5) + (a << 3);
    a = (a ^ 0xb55a4f09) ^ (a >> 16);
    return a;
}